  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AndesSim.UI.SuspectBoardVR
  suspects:
  - id: SUSPECT_SAMUEL_TORRES
    fullName: Ing. Samuel Torres
    roleTitle: Jefe de Seguridad TI
    threatLevelBadge: NEGLIGENCIA DE RED
    threatColorHex: '#ff5a4e'
    careerAndPsychology: "\u2022 12 anos en redes bancarias.\n\u2022 Molesto por
      recortes de presupuesto."
    incriminatingPoints: "\u2022 Administrador total de correo y switches.\n\u2022
      No bloqueo archivos .exe ni puso VLANs."
    exoneratingPoints: "\u2022 Envio 3 informes pidiendo un Sandbox.\n\u2022 No uso
      su clave en el robo."
    reason16Recipients: Dejo abierto el grupo de correo al exterior.
    reasonCarlaPostIt: Exigia claves largas cada mes sin gestor.
    reasonNoFirewallSandbox: Sin dinero aprobado, no activo filtros.
    teamHypothesisArgument: <b>CONCLUSION:</b> Por pasividad y falta de filtros dejo
      la red vulnerable.
  - id: SUSPECT_HUGO_BENAVIDES
    fullName: Lic. Hugo Benavides
    roleTitle: Gerente de Operaciones
    threatLevelBadge: DESIDIA GERENCIAL
    threatColorHex: '#ffc24a'
    careerAndPsychology: "\u2022 18 anos en metas comerciales.\n\u2022 Ve la seguridad
      como un freno."
    incriminatingPoints: "\u2022 Ignoro fallas en impresora SWIFT.\n\u2022 Pidio
      quitar filtros para ir rapido."
    exoneratingPoints: "\u2022 Sin conocimientos tecnicos de hacking.\n\u2022 Estaba
      de viaje en otro evento."
    reason16Recipients: Publico correos del equipo en avisos.
    reasonCarlaPostIt: Acepto claves en Post-It para ir rapido.
    reasonNoFirewallSandbox: Voto en contra de comprar el Sandbox.
    teamHypothesisArgument: <b>CONCLUSION:</b> Su presion y recortes anularon la
      seguridad.
  - id: SUSPECT_CARLA_MENDOZA
    fullName: Carla Mendoza
    roleTitle: Operadora Senior SWIFT
    threatLevelBadge: VICTIMA PHISHING
    threatColorHex: '#38f28a'
    careerAndPsychology: "\u2022 7 anos con record puntual.\n\u2022 Trabajaba bajo
      mucho estres."
    incriminatingPoints: "\u2022 Su usuario autorizo los giros SWIFT.\n\u2022 Tenia
      su clave pegada en Post-It."
    exoneratingPoints: "\u2022 Estaba en casa durante el robo nocturno.\n\u2022 Fue
      enganada por el correo falso."
    reason16Recipients: Su correo aparecia en contactos externos.
    reasonCarlaPostIt: Anoto la clave para no bloquear cierres.
    reasonNoFirewallSandbox: Confio en que el filtro ya bloqueaba virus.
    teamHypothesisArgument: <b>CONCLUSION:</b> Victima sin capacitacion explotada
      por phishing.
  - id: SUSPECT_RENZO_ALIAGA
    fullName: Renzo Aliaga
    roleTitle: Soporte Redes (Externo)
    threatLevelBadge: SOSPECHOSO INTERNO
    threatColorHex: '#ff5a4e'
    careerAndPsychology: "\u2022 4 anos viendo cableado de oficina.\n\u2022 Tiene
      deudas bancarias graves."
    incriminatingPoints: "\u2022 Trabajo bajo el escritorio de Carla.\n\u2022 Entro
      de noche a servidores sin guia."
    exoneratingPoints: "\u2022 Tenia ordenes de trabajo firmadas.\n\u2022 Camaras
      no muestran uso de USB."
    reason16Recipients: Pudo ver la lista de correos en PC 1.
    reasonCarlaPostIt: Cableo justo debajo del Post-It de Carla.
    reasonNoFirewallSandbox: Sabia que la red no tenia proteccion.
    teamHypothesisArgument: <b>CONCLUSION:</b> Posible complice interno que filtro
      claves y red.
