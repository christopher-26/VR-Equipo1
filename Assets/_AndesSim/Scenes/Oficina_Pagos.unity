  m_text: "<align=right><size=10><color=#556677><b>EXPEDIENTE 02</b></color></size></align>\n<line-height=110%><size=18><b>Lic.
    Hugo Benavides</b></size>\n<size=12><color=#2C3E50>Gerente de Operaciones</color></size></line-height>\n\n<size=10><mark=#ffc24a44><color=#ffc24a><b>
    SOSPECHOSO: DESIDIA GERENCIAL Y ENCUBRIMIENTO </b></color></mark></size>\n\n<size=11><color=#A93226><b>[INDICIOS
    EN CONTRA]:</b></color>\n<line-height=105%>\u2022 Vot\xF3 en contra de adquirir
    Sandbox.\n\u2022 Ignor\xF3 impresora de auditor\xEDa apagada.\n\u2022 Alentaba
    uso informal de claves.</line-height>\n\n<color=#196F3D><b>[ELEMENTOS A FAVOR]:</b></color>\n<line-height=105%>\u2022
    Cero conocimientos t\xE9cnicos de redes.\n\u2022 Fuera de la ciudad durante el
    ataque.</line-height></size>\n\n<align=center><size=11><color=#1A5276><b>[>]
    MIRAR CON RET\xCDCULA PARA ABRIR DOSSIER</b></color></size></align>"
