  m_text: "<align=right><size=12><color=#556677><b>FICHA 01</b></color></size></align>\n<line-height=110%><size=21><b>Samuel
    Torres</b></size>\n<size=14><color=#2C3E50>Jefe de Seguridad TI</color></size></line-height>\n\n<size=12><mark=#ff5a4e44><color=#ff5a4e><b>
    NEGLIGENCIA DE RED </b></color></mark></size>\n\n<size=14><color=#A93226><b>EN
    CONTRA:</b></color>\n\u2022 Red sin Sandbox ni bloqueos.\n\n<color=#196F3D><b>A
    FAVOR:</b></color>\n\u2022 Advirtio fallas en informes.</size>\n\n<align=center><size=13><color=#1A5276><b>[
    > MIRA PARA ABRIR ]</b></color></size></align>"
