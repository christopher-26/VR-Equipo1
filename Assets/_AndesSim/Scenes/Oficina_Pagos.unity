  m_text: "<align=right><size=10><color=#556677><b>EXPEDIENTE 04</b></color></size></align>\n<line-height=110%><size=18><b>Renzo
    Aliaga</b></size>\n<size=12><color=#2C3E50>T\xE9cnico Soporte NetSolutions</color></size></line-height>\n\n<size=10><mark=#ff5a4e44><color=#ff5a4e><b>
    SOSPECHOSO: C\xD3MPLICE INTERNO / INSIDER </b></color></mark></size>\n\n<size=11><color=#A93226><b>[INDICIOS
    EN CONTRA]:</b></color>\n<line-height=105%>\u2022 Deudas bancarias en cobranza
    judicial.\n\u2022 Mantenimiento f\xEDsico bajo escritorios.\n\u2022 Ingresos
