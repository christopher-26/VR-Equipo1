  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>\xBFPor qu\xE9 el correo lleg\xF3 a 16 personas?:</b> Mantuvo
    abierta la lista de distribuci\xF3n global 'pagos-personal@bancoandino.pe' sin
    autenticaci\xF3n SPF/DKIM para remitentes externos, permitiendo que un correo
    spoofing desde career-applicants-bd.com ingresara sin filtro a los 16 buzones
    del \xE1rea.\n\u2022 <b>\xBFPor qu\xE9 la clave de Carla estaba en un Post-It?:</b>
    Estableci\xF3 una pol\xEDtica de seguridad draconiana obligando a cambiar contrase\xF1as
    de 16 caracteres alfanum\xE9ricos cada 30 d\xEDas, pero deneg\xF3 la adquisici\xF3n
    de un gestor de contrase\xF1as corporativo y no provey\xF3 llaves MFA, forzando
    a los operadores a anotar sus claves.\n\u2022 <b>\xBFPor qu\xE9 la red carec\xEDa
    de firewall/sandbox?:</b> Su solicitud formal de presupuesto para un Appliance
    Sandbox de detonaci\xF3n de malware fue rechazada por gerencia por considerarla
    'costosa'; en represalia pasiva, no implement\xF3 reglas locales de software
    ni scripts perimetrales de contingencia."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
